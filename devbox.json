{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "curl@8.22.0",
    "git@2.53.0",
    "gnupg@2.4.9",
    "mkpasswd@5.6.6",
    "pwgen@2.08",
    "whois@5.6.6",
    "xorriso@1.5.7"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "build": [
        "cat ${HOME}/.ssh/id_ed25519.pub > configs/authorized_keys",
        "./build.sh -u 'janitor' -n 'calculon' -d 'example.org' -a 'age' -a 'jq' -a 'strace' -x -z",
        "cat *.sum"
      ]
    }
  }
}
